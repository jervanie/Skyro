local function flyThrough(hrp, waypoints)
    if not alive(hrp) or #waypoints == 0 then return end
    local speed = math.clamp(tonumber(Config.TPSpeed) or 450, 50, 600)
    local char = hrp.Parent
    local hum = char:FindFirstChildOfClass("Humanoid")
