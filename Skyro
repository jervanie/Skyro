        S.flyPre = function(dt)
            if done or not alive(hrp) then return finish() end
            if lifting and hum and hum.Parent then
                pcall(function()
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    hum.Jump = true
                end)
            end
            local A, B = pts[idx - 1], pts[idx]
            local AB = B - A
            local len = AB.Magnitude
            if len < 0.05 then
                if idx >= n then return finish() end
                idx += 1
                return
            end
            local dir = AB.Unit
            local along = (hrp.Position - A):Dot(dir)
            local toB = B - hrp.Position
            if idx >= n then
                if along >= len - 4 or toB.Magnitude < 4 then return finish() end
            elseif along >= len - 1 or dir:Dot(toB) <= 0 then
                idx += 1
                local nxt = pts[idx] - hrp.Position
                if nxt.Magnitude > 0.05 then dir = nxt.Unit end
                return push(dir, dt)
            end
            local aim = A + dir * math.clamp(along + 6, 0, len) - hrp.Position
            if aim.Magnitude > 0.5 then dir = aim.Unit end
            push(dir, dt)
        end
        S.flyHb = function()
            if done or not alive(hrp) then return finish() end
            if not carpetHeld() then pcall(equipCarpet) end
        end
        local total = 0
        for i = 2, n do total += (pts[i] - pts[i - 1]).Magnitude end
