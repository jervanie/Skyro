    local RADIUS = 120
    local LANES = {
        { -337.448303, -328.004578, -122.397758, 242.625626 },
        { -327.25766, -320.600891, -122.228622, 242.612259 },
        { -319.783386, -312.908325, -122.227089, 242.585617 },
