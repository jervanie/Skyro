            end
            xconns[#xconns + 1] = plots.ChildAdded:Connect(function(p)
                task.wait(0.2)
                if my == gen then pcall(plot, p, my) end
            end)
        end)
    end
    S.xrayStop = function() S.setXRay(false) end
    if Config.XRay then S.setXRay(true) end
