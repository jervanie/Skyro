        tracked[p] = true
        local function burst()
            local hrp = hrpOf()
            if not (hrp and eligible(p, hrp.Position)) then return end
            local now = os.clock()
            if lastBurst[p] and now - lastBurst[p] < 0.08 then return end
            lastBurst[p] = now
            fire(p, 25, 0)
        end
        task.defer(burst)
        bind(p:GetPropertyChangedSignal("Enabled"), function()
            if p.Enabled then burst() end
        end)
        bind(p.AncestryChanged, function()
            if not p:IsDescendantOf(workspace) then
                tracked[p], lastFire[p], lastBurst[p] = nil, nil, nil
            end
        end)
    end
    local plots = workspace:FindFirstChild("Plots")
