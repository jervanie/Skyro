            local s = input.Text:gsub("^%s+", ""):gsub("%s+$", "")
            if s == "" then return end
            table.insert(Config.PriorityList, 1, s)
            input.Text = ""
            changed()
        end)
        local function small(parent, text, x, fn)
            local b = new("TextButton", {
                Size = UDim2.fromOffset(20, 20), Position = UDim2.new(1, x, 0, 1), BackgroundColor3 = COL.hover,
                Text = text, Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = COL.text, AutoButtonColor = false,
            }, parent)
            corner(b, 5)
            b.MouseButton1Click:Connect(fn)
        end
        refreshPrio = function()
            for _, ch in ipairs(scroll:GetChildren()) do
                if ch:IsA("Frame") then ch:Destroy() end
            end
            local L = Config.PriorityList
            for i, name in ipairs(L) do
                local row = new("Frame", { Size = UDim2.new(1, -6, 0, 22), BackgroundColor3 = COL.row, LayoutOrder = i }, scroll)
                corner(row, 5)
                new("TextLabel", {
                    Size = UDim2.new(1, -74, 1, 0), Position = UDim2.fromOffset(6, 0), BackgroundTransparency = 1,
                    Text = i .. ". " .. name, Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = COL.text,
                    TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
                }, row)
                small(row, "^", -66, function()
                    if i > 1 then L[i], L[i - 1] = L[i - 1], L[i]; changed() end
                end)
                small(row, "v", -44, function()
                    if i < #L then L[i], L[i + 1] = L[i + 1], L[i]; changed() end
                end)
                small(row, "x", -22, function()
                    table.remove(L, i)
                    changed()
                end)
            end
        end
    end
    local listening
    do
        local keyBtns = {}
        for i, a in ipairs(ACTIONS) do
            local row = new("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, LayoutOrder = i }, bindPage)
            new("TextLabel", {
                Size = UDim2.new(1, -94, 1, 0), BackgroundTransparency = 1, Text = a.label,
                Font = Enum.Font.GothamMedium, TextSize = TXT, TextColor3 = COL.dim, TextXAlignment = Enum.TextXAlignment.Left,
            }, row)
            local b = new("TextButton", {
                Size = UDim2.new(0, 90, 1, 0), Position = UDim2.new(1, -90, 0, 0), BackgroundColor3 = COL.row,
                Text = tostring(Config.Keybinds[a.key] or "NONE"), Font = Enum.Font.GothamMedium, TextSize = TXT,
                TextColor3 = COL.text, AutoButtonColor = false,
            }, row)
            corner(b, 6)
            keyBtns[a.key] = b
            b.MouseButton1Click:Connect(function()
                if listening then keyBtns[listening].Text = Config.Keybinds[listening] or "NONE" end
                listening = a.key
                b.Text = "..."
            end)
        end
        new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, Text = "Esc / Backspace = none",
            Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = COL.dim, LayoutOrder = 99,
        }, bindPage)
        S.setBind = function(key)
            local a = listening
            listening = nil
            Config.Keybinds[a] = key
            keyBtns[a].Text = key
            saveConfig()
        end
    end
    if MOBILE then
        if type(Config.UiPos.Quick) ~= "table" then Config.UiPos.Quick = {} end
        local QP = Config.UiPos.Quick
        local BTN, GAP = 60, 8
        if type(Config.MobileHidden) ~= "table" then Config.MobileHidden = {} end
        local qb = {}   
        local function applyQuick()
            local sc = math.clamp(tonumber(Config.MobileButtonScale) or 100, 50, 150) / 100
            for name, e in pairs(qb) do
                e.sc.Scale = sc
                e.b.Visible = name == "Menu" or (Config.MobileButtons and not Config.MobileHidden[name])
            end
        end
        local function grad(b, on)
            local g = b:FindFirstChild("BtnGrad")
            local c = COL.accent
            g.Color = on and ColorSequence.new({
                ColorSequenceKeypoint.new(0, c:Lerp(Color3.new(1, 1, 1), 0.55)),
                ColorSequenceKeypoint.new(0.45, c),
                ColorSequenceKeypoint.new(1, c:Lerp(Color3.new(0, 0, 0), 0.35)),
            }) or ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(252, 252, 253)),
                ColorSequenceKeypoint.new(0.45, Color3.fromRGB(233, 233, 236)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(168, 168, 176)),
            })
            b.TextColor3 = on and Color3.new(1, 1, 1) or Color3.fromRGB(32, 32, 40)
            local st = b:FindFirstChildOfClass("UIStroke")
            st.Color = on and c or Color3.fromRGB(120, 120, 128)
            st.Transparency = on and 0.1 or 0.55
            st.Thickness = on and 1.5 or 1
        end
        local function qbtn(i, name, text, fn)
            local col, row = (i - 1) % 2, math.floor((i - 1) / 2)
            local p = QP[name]
            local home = UDim2.new(1, -(BTN + GAP) * (2 - col), 0.5, -140 + row * (BTN + GAP + 4))
            local b = new("TextButton", {
                Name = name, Size = UDim2.fromOffset(BTN, BTN),
                Position = type(p) == "table" and UDim2.new(p[1] or 0, p[2] or 0, p[3] or 0, p[4] or 0) or home,
                BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Text = text, Font = Enum.Font.GothamBlack,
                TextSize = 11, TextWrapped = true, AutoButtonColor = false, Active = true, ZIndex = 10,
            }, gui)
            corner(b, 18)
            new("UIGradient", { Name = "BtnGrad", Rotation = 90 }, b)
            new("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, b)
            grad(b, false)
            qb[name] = { b = b, sc = new("UIScale", {}, b), home = home, text = text }
            local active, from, start, moved
            b.InputBegan:Connect(function(inp)
                if active then return end
                if inp.UserInputType ~= Enum.UserInputType.Touch and inp.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                active, from, start, moved = inp, inp.Position, b.Position, false
            end)
            bind(UIS.InputChanged, function(inp)
                if not active then return end
                local touch = active.UserInputType == Enum.UserInputType.Touch and inp == active
                local mouse = active.UserInputType == Enum.UserInputType.MouseButton1 and inp.UserInputType == Enum.UserInputType.MouseMovement
                if not touch and not mouse then return end
                local d = inp.Position - from
                if d.Magnitude > 12 then moved = true end
                if moved and not Config.MobileLock then
                    b.Position = UDim2.new(start.X.Scale, start.X.Offset + d.X, start.Y.Scale, start.Y.Offset + d.Y)
                end
            end)
            bind(UIS.InputEnded, function(inp)
                if not active then return end
                if inp ~= active and not (active.UserInputType == Enum.UserInputType.MouseButton1 and inp.UserInputType == Enum.UserInputType.MouseButton1) then
                    return
                end
                active = nil
                if moved then
                    if Config.MobileLock then return end
                    local q = b.Position
                    QP[name] = { q.X.Scale, q.X.Offset, q.Y.Scale, q.Y.Offset }
                    saveConfig()
                else
                    pcall(fn)
                end
            end)
            return function(on) grad(b, on) end
        end
        local qMenu = qbtn(1, "Menu", "MENU", function() card.Visible = not card.Visible end)
        qbtn(2, "TP", "TP +\nCLONE", function() task.spawn(doTP) end)
        local qInvis = qbtn(3, "Invis", "INVIS", function() S.invisToggle() end)
        local qNear = qbtn(4, "Nearest", "STEAL\nNEAR", function() S.setStealNearest(not Config.StealNearest) end)
        qbtn(5, "Reset", "INSTA\nRESET", function() S.instaReset() end)
        qbtn(6, "Drop", "DROP\nBR", function() S.dropBrainrot() end)
        local qBuy = qbtn(7, "AutoBuy", "AUTO\nBUY", function() S.setAutoBuy(not Config.AutoBuy) end)
        local qSpeed = qbtn(8, "Carpet", "CARPET\nSPD", function() S.setCarpetSpeed(not Config.CarpetSpeed) end)
        qMenu(card.Visible)
        card:GetPropertyChangedSignal("Visible"):Connect(function() qMenu(card.Visible) end)
        qNear(Config.StealNearest == true)
        qBuy(Config.AutoBuy == true)
        qSpeed(Config.CarpetSpeed == true)
        local oInvis, oNear, oBuy, oSpeed = S.onInvis, S.setStealNearest, S.setAutoBuy, S.setCarpetSpeed
        S.onInvis = function(on) oInvis(on); qInvis(on) end
        S.setStealNearest = function(on) oNear(on); qNear(on) end
        S.setAutoBuy = function(on) oBuy(on); qBuy(on) end
        S.setCarpetSpeed = function(on) oSpeed(on); qSpeed(on) end
        toggles.StealNearest.MouseButton1Click:Connect(function() task.defer(function() qNear(Config.StealNearest == true) end) end)
        toggles.AutoBuy.MouseButton1Click:Connect(function() task.defer(function() qBuy(Config.AutoBuy == true) end) end)
        toggles.CarpetSpeed.MouseButton1Click:Connect(function() task.defer(function() qSpeed(Config.CarpetSpeed == true) end) end)
        applyQuick()
        local function stepper(order, text, key)
            local row = new("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = order }, mobilePage)
            new("TextLabel", {
                Size = UDim2.new(1, -112, 1, 0), BackgroundTransparency = 1, Text = text,
                Font = Enum.Font.GothamMedium, TextSize = TXT, TextColor3 = COL.dim, TextXAlignment = Enum.TextXAlignment.Left,
            }, row)
            local val = new("TextLabel", {
                Size = UDim2.fromOffset(44, 30), Position = UDim2.new(1, -78, 0, 0), BackgroundColor3 = COL.input,
                Text = "", Font = Enum.Font.GothamBold, TextSize = TXT, TextColor3 = COL.text,
            }, row)
            corner(val, 6)
            local function show() val.Text = tostring(Config[key]) .. "%" end
            local function step(d)
                Config[key] = math.clamp((tonumber(Config[key]) or 100) + d, 50, 150)
                show()
                saveConfig()
                if key == "MobileMenuScale" then S.menuScale() else applyQuick() end
            end
            for _, s in ipairs({ { "-", -112, -10 }, { "+", -30, 10 } }) do
                local b = new("TextButton", {
                    Size = UDim2.fromOffset(30, 30), Position = UDim2.new(1, s[2], 0, 0), BackgroundColor3 = COL.accent,
                    Text = s[1], Font = Enum.Font.GothamBlack, TextSize = 16, TextColor3 = Color3.new(1, 1, 1), AutoButtonColor = false,
                }, row)
                corner(b, 6)
                b.MouseButton1Click:Connect(function() step(s[3]) end)
            end
            show()
            return show
        end
        local showMenu = stepper(1, "Menu Size", "MobileMenuScale")
        local showBtn = stepper(2, "Button Size", "MobileButtonScale")
        local g = grid(3, mobilePage)
        toggle(g, "Quick Buttons", "MobileButtons", applyQuick)
        toggle(g, "Lock Layout", "MobileLock")
        new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Text = "show button (MENU always shows)",
            Font = Enum.Font.Gotham, TextSize = TXT - 1, TextColor3 = COL.dim, TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 4,
        }, mobilePage)
        local g3 = grid(5, mobilePage)
        local shown = {}
        for _, name in ipairs({ "TP", "Invis", "Nearest", "Reset", "Drop", "AutoBuy", "Carpet" }) do
            local b
            b = button(g3, qb[name].text:gsub("\n", " "), function()
                Config.MobileHidden[name] = not Config.MobileHidden[name] or nil
                paint(b, not Config.MobileHidden[name])
                saveConfig()
                applyQuick()
            end)
            paint(b, not Config.MobileHidden[name])
            shown[name] = b
        end
        local reset = new("TextButton", {
            Size = UDim2.new(1, 0, 0, CELL), BackgroundColor3 = COL.row, Text = "Reset Layout",
            Font = Enum.Font.GothamBold, TextSize = TXT, TextColor3 = COL.text, AutoButtonColor = false, LayoutOrder = 6,
        }, mobilePage)
        corner(reset, 8)
        reset.MouseButton1Click:Connect(function()
            table.clear(QP)
            table.clear(Config.MobileHidden)
            Config.MobileMenuScale, Config.MobileButtonScale = 100, 100
            Config.MobileButtons, Config.MobileLock = true, false
            paint(toggles.MobileButtons, true)
            paint(toggles.MobileLock, false)
            for _, b in pairs(shown) do paint(b, true) end
            for _, e in pairs(qb) do e.b.Position = e.home end
            card.Position = UDim2.new(0, 20, 0.5, -160)
            Config.UiPos.Main = nil
            showMenu()
            showBtn()
            S.menuScale()
            applyQuick()
            saveConfig()
        end)
    end
    runAction.Menu = function() card.Visible = not card.Visible end
    S.isListening = function() return listening ~= nil end
end
