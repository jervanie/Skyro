    local cam = workspace.CurrentCamera
    local fov = math.clamp(tonumber(Config.FOV) or 70, 50, 120)
    if cam and cam.FieldOfView ~= fov then cam.FieldOfView = fov end
end)
runAction.TP = function() task.spawn(doTP) end
runAction.StealNearest = function() S.setStealNearest(not Config.StealNearest) end
runAction.Invis = function() S.invisToggle() end
runAction.AutoBuy = function() S.setAutoBuy(not Config.AutoBuy) end
runAction.CarpetSpeed = function() S.setCarpetSpeed(not Config.CarpetSpeed) end
runAction.Reset = function() S.instaReset() end
runAction.Drop = function() S.dropBrainrot() end
bind(UIS.InputBegan, function(input, processed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local name = input.KeyCode.Name
    if S.isListening() then
        if name == "Escape" or name == "Backspace" then name = "NONE" end
        S.setBind(name)
        return
    end
    if processed then return end
    for _, a in ipairs(ACTIONS) do
        if Config.Keybinds[a.key] == name then
            pcall(runAction[a.key])
        end
    end
end)
if Config.AutoTP then
    task.spawn(function()
        local t0, since = os.clock(), nil
        local function ready()
            local hrp, hum = hrpOf()
            if not (hrp and hum and hum.Health > 0) then return false end
            if not findTool("Grapple Hook") then return false end
            return remoteByHash("75c9466d-e4c0-4b02-b26a-c3615fcc1e42") ~= nil
        end
        local streamed = {}
        local function streamTo(pet)
            if not workspace.StreamingEnabled or petPodium(pet) then return end
            local key = tostring(pet.plot)
            if streamed[key] then return end
            local pos = petPos(pet)
            if not pos then return end
            streamed[key] = true
            task.spawn(pcall, LP.RequestStreamAroundAsync, LP, pos, 5)
        end
        while os.clock() - t0 < 30 and not S.dead do
            if S.tpBusy or isStealing() then return end
            local best = listPrio()[1]
            if best then streamTo(best) end
            if ready() then since = since or os.clock() else since = nil end
            local pet = since and os.clock() - since >= 0.1 and best
            if pet and (petPodium(pet) or os.clock() - t0 > 2.5) and petPos(pet) then
                doTP(pet)
                return
            end
            task.wait(0.03)
        end
    end)
end
