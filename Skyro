local FALLBACK_GEN = 5e7
local function listPrio()
    local out = {}
    local reg = chans()
    if type(reg) ~= "table" then return out end
    local best
    for name, ch in next, reg do
        if isPlotKey(name) and type(ch) == "table" then
            if isMyPlot(ch) then
                S.myPlot = tostring(name)
            else
                local list = chanGet(ch, "AnimalList")
                if type(list) == "table" then
                    for slot, ad in pairs(list) do
                        if type(ad) == "table" and type(ad.Index) == "string" and not isFusing(ad) then
                            local r = prioOf(ad.Index)
                            if r then
                                local mut = adMut(ad)
                                out[#out + 1] = {
                                    name = ad.Index, mutation = mut, rank = r, mutRank = mutRankOf(mut),
                                    plot = tostring(name), slot = tostring(slot),
                                }
                            elseif #out == 0 and S.genOf then
                                local gen = S.genOf(ad)
                                if gen >= FALLBACK_GEN and (not best or gen > best.gen) then
                                    local mut = adMut(ad)
                                    best = {
                                        name = ad.Index, mutation = mut, rank = 999, mutRank = mutRankOf(mut),
                                        gen = gen, plot = tostring(name), slot = tostring(slot),
                                    }
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    if #out == 0 then
        out[1] = best
        return out
    end
    table.sort(out, function(a, b)
        if a.rank ~= b.rank then return a.rank < b.rank end
        return a.mutRank < b.mutRank
    end)
    return out
end
