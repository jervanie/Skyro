    local function eligible(p, myPos)
        local RC = S.camp
        if not (RC and RC.active and RC.arrived and RC.plotName) then return false end
        if not p.Parent or not p.Enabled then return false end
        local plots = workspace:FindFirstChild("Plots")
        local plot = p
        while plot and plots and plot.Parent ~= plots do plot = plot.Parent end
        if not plot or plot.Name ~= RC.plotName then return false end
        local at = promptAt(p)
        if not at then return false end
        if laneMode then
            local a = laneOf(myPos)
            if not a or a ~= laneOf(at) then return false end
        end
        return (at - myPos).Magnitude <= RADIUS
    end
    local function fire(p, n, debounce)
        if type(fireproximityprompt) ~= "function" or not p.Parent or not p.Enabled then return end
        local now = os.clock()
