    if hum then
        pcall(function()
            jp = hum.JumpPower
            hum.PlatformStand, hum.Sit = false, false
            hum.UseJumpPower = true
            if (hum.JumpPower or 0) < 50 then hum.JumpPower = 50 end
            hum:SetStateEnabled(Enum.HumanoidStateType.Landed, false)
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            hum.Jump = true
        end)
    end
    local restored = false
    local function restore()
        if restored then return end
        restored = true
        S.flyRestore = nil
        S.flyPre, S.flyHb = nil, nil
        if hum and hum.Parent then
            pcall(function()
                hum:SetStateEnabled(Enum.HumanoidStateType.Landed, true)
                if jp then hum.JumpPower = jp end
            end)
        end
        if animate and animate.Parent then pcall(function() animate.Disabled = false end) end
        if hrp.Parent then pcall(function() hrp.CanCollide = true end) end
        S.flying = false
    end
    S.flyRestore = restore
    local pts = { hrp.Position }
    for _, p in ipairs(waypoints) do
        if (p - pts[#pts]).Magnitude > 0.25 then pts[#pts + 1] = p end
    end
    local n = #pts
    local done = n < 2
    local idx, lastClock = 2, 0
    local takeoffY = pts[1].Y
    local lifting = not (hum and hum.FloorMaterial == Enum.Material.Air)
    local function finish()
        done = true
        S.flyPre, S.flyHb = nil, nil
    end
    pcall(function() hrp.CanCollide = false end)
    local function push(dir, dt)
        if dir.Magnitude < 0.1 then return end
        local now = os.clock()
        local step = lastClock > 0 and now - lastClock or tonumber(dt) or 0.016
        lastClock = now
        local spd = speed
        if step > 0.018 then spd = math.max(math.min(spd, 8 / step), 40) end
        local t = dir.Unit
        if lifting and hrp.Position.Y - takeoffY >= 3 then lifting = false end
        if lifting then
            local jy = 50 / math.max(spd, 1)
            if t.Y < jy then t = Vector3.new(t.X, jy, t.Z).Unit end
        end
        hrp.AssemblyLinearVelocity = t * spd
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
