do
    local ALPHA = 0.5
    local FOLDERS = { "Base", "PlotSign", "FriendPanel", "Cash", "Laser", "Decorations", "Skin", "Unlock", "Purchases" }
    local orig = setmetatable({}, { __mode = "k" })
    local xconns = {}
    local gen = 0
    local function fade(v) return v + (1 - v) * ALPHA end
    local function apply(obj)
        if obj:IsA("BasePart") then
            if orig[obj] == nil then orig[obj] = obj.Transparency == ALPHA and 0 or obj.Transparency end
            if orig[obj] < 1 then obj.Transparency = fade(orig[obj]) end
        elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
            if orig[obj] == nil then
                local t, b = obj.TextTransparency, obj.BackgroundTransparency
                orig[obj] = { text = t == ALPHA and 0 or t, bg = b == ALPHA and 0 or b }
            end
            local o = orig[obj]
            if o.text < 1 then obj.TextTransparency = fade(o.text) end
            if o.bg < 1 then obj.BackgroundTransparency = fade(o.bg) end
        elseif obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
            if orig[obj] == nil then orig[obj] = obj.BackgroundTransparency == ALPHA and 0 or obj.BackgroundTransparency end
            if orig[obj] < 1 then obj.BackgroundTransparency = fade(orig[obj]) end
        elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            if orig[obj] == nil then
                local i, b = obj.ImageTransparency, obj.BackgroundTransparency
                orig[obj] = { img = i == ALPHA and 0 or i, bg = b == ALPHA and 0 or b }
            end
            local o = orig[obj]
            if o.img < 1 then obj.ImageTransparency = fade(o.img) end
            if o.bg < 1 then obj.BackgroundTransparency = fade(o.bg) end
        end
    end
    local function subtree(root, my)
        if not root or my ~= gen then return end
        pcall(apply, root)
        for i, d in ipairs(root:GetDescendants()) do
            pcall(apply, d)
            if i % 300 == 0 then
                task.wait()
                if my ~= gen then return end
            end
        end
        xconns[#xconns + 1] = root.DescendantAdded:Connect(function(d)
            if my == gen then pcall(apply, d) end
        end)
    end
    local function podium(pod, my)
        for _, child in ipairs(pod:GetChildren()) do
            if child.Name == "Claim" then
                subtree(child, my)
            elseif child.Name == "Base" then
                subtree(child:FindFirstChild("Decorations"), my)
            elseif child:IsA("Model") and child.Name ~= "Decorations" then
                subtree(child, my)
            end
        end
    end
    local function plot(p, my)
        for _, name in ipairs(FOLDERS) do subtree(p:FindFirstChild(name), my) end
        xconns[#xconns + 1] = p.ChildAdded:Connect(function(child)
            if my == gen and table.find(FOLDERS, child.Name) then subtree(child, my) end
        end)
        local pods = p:FindFirstChild("AnimalPodiums")
        if pods then
            for _, pod in ipairs(pods:GetChildren()) do podium(pod, my) end
            xconns[#xconns + 1] = pods.ChildAdded:Connect(function(pod)
                task.wait(0.1)
                if my == gen then podium(pod, my) end
            end)
        end
    end
    local function restore()
        local snap = orig
        orig = setmetatable({}, { __mode = "k" })
        for obj, o in pairs(snap) do
            pcall(function()
                if obj:IsA("BasePart") then
                    obj.Transparency = o
                elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
                    obj.TextTransparency, obj.BackgroundTransparency = o.text, o.bg
                elseif obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
                    obj.BackgroundTransparency = o
                elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                    obj.ImageTransparency, obj.BackgroundTransparency = o.img, o.bg
                end
            end)
        end
    end
    S.setXRay = function(on)
        for _, c in ipairs(xconns) do pcall(function() c:Disconnect() end) end
        table.clear(xconns)
        gen += 1
        local my = gen
        if not on then
            restore()
            return
        end
        task.spawn(function()
            local plots = workspace:WaitForChild("Plots", 30)
            if not plots or my ~= gen then return end
            for _, p in ipairs(plots:GetChildren()) do
