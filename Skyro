    local function run(pet, camp)
        local hrp = hrpOf()
        if not hrp then return end
        if not pet then
            pet = listPrio()[1]
            local t0 = os.clock()
            while not pet and os.clock() - t0 < 2 do
                task.wait(0.1)
                pet = listPrio()[1]
            end
        end
        if not pet then return end
        if not camp then armSteal(pet) end
        local pos = petPos(pet)
        local t1 = os.clock()
        while not pet.position and os.clock() - t1 < 2 do
            RunService.Heartbeat:Wait()
            pos = petPos(pet)
        end
        if not pos then return end
        pcall(carpetEngage)
        hrp = hrpOf()
        if not hrp then return end
        if pos.Y <= 8.9 and isUnlocked(pet.plot) then
            local to = Vector3.new(pos.X, Map.FRONT_Y_LOW, pos.Z)
            flyTo(to)
            vZero(hrpOf())
            return
        end
        local dest, face = cloneSpot(hrp.Position, pos, pet.name)
        dest = wallFront(dest, face)
        local function steps(from, route)
            local out, prev = {}, from
            for _, wp in ipairs(route) do
                local dy = wp.Y - prev.Y
                if dy > 15 then
                    local n = math.ceil(dy / 10)
                    for k = 1, n - 1 do
                        out[#out + 1] = prev:Lerp(wp, k / n)
                    end
                end
                out[#out + 1] = wp
                prev = wp
            end
            return out
        end
        local arrived = flyTo(dest, face, steps)
        hrp = hrpOf()
        if not hrp or S.resortTo then return end
        if not arrived then
            warn("[" .. TAG .. "] tp: didn't reach the wall, no clone")
            vZero(hrp)
            return
        end
        local look = Vector3.new(face.X, 0, face.Z)
        look = look.Magnitude > 0.1 and look.Unit or Vector3.new(0, 0, -1)
        local hit
        dest, hit = wallFront(dest, face)
        if not string.find(string.lower(hit or ""), "laser", 1, true) then
            dest += look * 0.45
        end
        hrp.Anchored = false
        hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + look)
        vZero(hrp)
        local stopFall = antiFall(hrp, dest)
        if not camp then armSteal(pet) end
        if Config.CloneDelay > 0 then task.wait(Config.CloneDelay) end
        local ok = instantClone()
        stopFall()
        if ok then
            S.isCloning = false
            task.wait(0.3)
            goToPet(pos)
        end
    end
    local TP_MAX = 25   
