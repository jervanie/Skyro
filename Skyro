local prioOf, mutRankOf, rebuildPrio
do
    local MUT_WORDS = {
        gold = true, diamond = true, rainbow = true, cyber = true, bloodrot = true, lava = true,
        galaxy = true, cursed = true, divine = true, radioactive = true, candy = true, crystal = true,
        celestial = true, phantom = true, eclipse = true, ["yin yang"] = true, yinyang = true,
    }
    local function norm(s)
        s = string.lower(tostring(s or ""))
        s = s:gsub("%[.-%]", " "):gsub("[^%w%s%-]", " "):gsub("%s+", " ")
        return (s:gsub("^%s+", ""):gsub("%s+$", ""))
    end
    local function peel(s)
        local changed = true
        while changed and s ~= "" do
            changed = false
            for word in pairs(MUT_WORDS) do
                local pre, suf = word .. " ", " " .. word
                if s:sub(1, #pre) == pre then
                    s = s:sub(#pre + 1)
                    changed = true
                    break
                elseif #s > #suf and s:sub(-#suf) == suf then
                    s = s:sub(1, #s - #suf)
                    changed = true
                    break
                end
            end
        end
        return s
    end
    local prioRank, mutRank = {}, {}
    rebuildPrio = function()
        table.clear(prioRank)
        for i, n in ipairs(Config.PriorityList) do
            local k = norm(n)
            if k ~= "" and not prioRank[k] then prioRank[k] = i end
        end
        table.clear(mutRank)
        for i, n in ipairs(Config.MutationList) do
            local k = string.lower(n):gsub("[%s%-_]", "")
            if k ~= "" then mutRank[k] = i end
            local w = norm(n)
            if w ~= "" then MUT_WORDS[w] = true end
        end
        mutRank.yingyang = mutRank.yinyang
        mutRank.divin = mutRank.divine
    end
    prioOf = function(name)
        local n = norm(name)
        if n == "" then return nil end
        local r = prioRank[n]
        if r then return r end
        local p = peel(n)
        return p ~= "" and prioRank[p] or nil
    end
    mutRankOf = function(m)
        local k = tostring(m or ""):lower():gsub("[%s%-_]", "")
        if k == "" or k == "none" or k == "normal" then return mutRank.normal or 99 end
        return mutRank[k] or 99
    end
    rebuildPrio()
end
local chans, chanGet, isMyPlot
do
    local cached, mod
