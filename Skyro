        local ok, PM = pcall(function()
            return require(game:GetService("ReplicatedStorage").Packages.PlayerMouse)
        end)
        if ok and PM and typeof(rawget(PM, "Hit")) == "CFrame" then
            local pos = PM.Hit.Position
            local mag = (pos - hrp.Position).Magnitude
            if mag >= 10 and mag <= 100 then return pos, mag end
        end
