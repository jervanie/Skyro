        { -525.236938, -514.265015, -122.409813, 242.608932 },
    }
    local function laneOf(p)
        for i, l in ipairs(LANES) do
            if p.X >= l[1] and p.X <= l[2] and p.Z >= l[3] and p.Z <= l[4] then return i end
        end
    end
    local function promptAt(p)
        local par = p.Parent
        if not par then return nil end
        if par:IsA("Attachment") and par.Parent then par = par.Parent end
        if par:IsA("BasePart") then return par.Position end
        if par:IsA("Model") then return par:GetPivot().Position end
