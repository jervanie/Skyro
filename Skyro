        for _, plot in ipairs(plots:GetChildren()) do
            local pods = plot:FindFirstChild("AnimalPodiums")
            if pods then
                for _, d in ipairs(pods:GetDescendants()) do
                    if d:IsA("ProximityPrompt") then track(d) end
                end
            end
        end
    end
    bind(workspace.DescendantAdded, function(d)
        if d:IsA("ProximityPrompt") and d:FindFirstAncestor("AnimalPodiums") then track(d) end
    end)
    task.spawn(function()
        while not S.dead do
            task.wait(0.1)
            local RC = S.camp
            local hrp = hrpOf()
            if RC and RC.active and RC.arrived and hrp then
                local myPos = hrp.Position
