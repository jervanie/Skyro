        if S.flyRestore then S.flyRestore() end
        local hrp = hrpOf()
        if hrp then pcall(function() hrp.Anchored = false end) end
        S.resortTo = nil
        if not ok then warn("[" .. TAG .. "] tp: " .. tostring(err)) end
