            if S.resortTo or S.dead then break end
            RunService.Heartbeat:Wait()
            if alive(hrp) then
                local d = (hrp.Position - pts[n]).Magnitude
                if d < best - 1 then
                    best = d
                    deadline = math.max(deadline, os.clock() + 1)
                end
            end
        end
    end
    finish()
    if alive(hrp) then
        pcall(function() hrp.CanCollide = true end)
        local dest = pts[n]
        if (hrp.Position - dest).Magnitude <= 12 then hrp.CFrame = CFrame.new(dest) end
        vZero(hrp)
    end
    restore()
    return alive(hrp) and (hrp.Position - pts[n]).Magnitude <= 6
end
